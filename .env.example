# Discord Bot Credentials
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# DeepSeek AI Engine
# If not configured, Foxty operates with deterministic heuristic brain in TEST_MODE
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Foxty Operational Modes
TEST_MODE=true
PORT=3000
NODE_ENV=development
